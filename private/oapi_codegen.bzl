"""oapi_codegen — runs oapi-codegen over an OpenAPI spec and declares the
generated Go file as the target's only output.

oapi-codegen formats its output with golang.org/x/tools/imports, which
shells out to `go env`. The action therefore puts the `go` binary from the
rules_go SDK on PATH (and sets GOROOT to it), so codegen works on a host with
no Go installed. That is also why this is a small custom rule rather than
`run_binary`: `run_binary` has no way to add the SDK to the action's PATH.

The command line is assembled as:

    oapi-codegen [-config <config>] [-package <package>] [-generate <a,b>] \
        -o <out> <spec>

oapi-codegen gives a config file's `output:` precedence over `-o`, so a config
that sets `output:` would write somewhere Bazel isn't looking. The action
checks that the declared file exists and fails with a pointer to that key.

oapi-codegen reads its own module path and version from Go build info, which
rules_go < 0.60 doesn't embed, so the header comes out as "Code generated by
unknown module path version unknown version". The action rewrites that one
line to the pinned module and version (private/versions.bzl). With build info
present the string never appears and the rewrite is a no-op.
"""

load(":versions.bzl", "OAPI_CODEGEN_VERSION")

_GO_TOOLCHAIN = "@rules_go//go:toolchain"

# Positional args: $1 go binary, $2 a file in GOROOT, $3 oapi-codegen,
# $4 declared output, $5 oapi-codegen version, then the oapi-codegen
# arguments.
_COMMAND = """\
set -eu
go_bin="$1"; goroot_file="$2"; codegen="$3"; out="$4"; version="$5"; shift 5
export GOROOT="$PWD/${goroot_file%/*}"
export PATH="$PWD/${go_bin%/*}:$PATH"
# Keep the goimports pass from consulting the network, a user go.env, a
# go.work, or a newer toolchain.
export GOTOOLCHAIN=local GOPROXY=off GOENV=off GOWORK=off GOFLAGS=
export GOCACHE="$PWD/$out.gocache" GOPATH="$PWD/$out.gopath"
"$codegen" -o "$out" "$@"
rm -rf "$out.gocache" "$out.gopath"
if [ ! -f "$out" ]; then
  echo "oapi_codegen: oapi-codegen did not write $out." >&2
  echo "  If the config file sets 'output:', remove it: the rule chooses the" >&2
  echo "  output path (see the 'out' attribute)." >&2
  exit 1
fi
unknown="unknown module path version unknown version"
if grep -q "$unknown" "$out"; then
  sed "s#$unknown#github.com/oapi-codegen/oapi-codegen/v2 version $version#" "$out" > "$out.tmp"
  mv "$out.tmp" "$out"
fi
"""

def _impl(ctx):
    if not ctx.attr.package and not ctx.file.config:
        fail("oapi_codegen {}: set `package`, or pass a `config` that sets `package:`".format(ctx.label))

    sdk = ctx.toolchains[_GO_TOOLCHAIN].sdk
    out = ctx.actions.declare_file(ctx.attr.out or ctx.label.name + ".gen.go")

    args = ctx.actions.args()
    args.add(sdk.go)
    args.add(sdk.root_file)
    args.add(ctx.executable._oapi_codegen)
    args.add(out)
    args.add(OAPI_CODEGEN_VERSION)
    if ctx.file.config:
        args.add("-config", ctx.file.config)
    if ctx.attr.package:
        args.add("-package", ctx.attr.package)
    generate = ctx.attr.generate
    if not generate and not ctx.file.config:
        generate = ["types", "client"]
    if generate:
        args.add("-generate", ",".join(generate))
    args.add(ctx.file.spec)

    inputs = [ctx.file.spec, sdk.go, sdk.root_file] + ctx.files.data
    if ctx.file.config:
        inputs.append(ctx.file.config)

    ctx.actions.run_shell(
        command = _COMMAND,
        arguments = [args],
        inputs = inputs,
        tools = [ctx.attr._oapi_codegen[DefaultInfo].files_to_run],
        outputs = [out],
        mnemonic = "OapiCodegen",
        progress_message = "Generating Go from OpenAPI spec %{label}",
    )
    return [DefaultInfo(files = depset([out]))]

oapi_codegen = rule(
    implementation = _impl,
    doc = "Generates one Go source file from an OpenAPI 3 spec with oapi-codegen.",
    attrs = {
        "spec": attr.label(
            allow_single_file = [".yaml", ".yml", ".json"],
            mandatory = True,
            doc = "The OpenAPI 3.0 spec (YAML or JSON).",
        ),
        "package": attr.string(
            doc = "Go package name for the generated file (`-package`). " +
                  "Required unless `config` sets `package:`; overrides it " +
                  "when both are given.",
        ),
        "generate": attr.string_list(
            doc = "What to generate (`-generate`), e.g. `['types', " +
                  "'client']` or `['types', 'std-http-server', " +
                  "'strict-server', 'spec']`. Overrides the config file's " +
                  "`generate:` when set. Defaults to `['types', 'client']` " +
                  "when there is no config file, and to the config file's " +
                  "choice when there is one.",
        ),
        "config": attr.label(
            allow_single_file = [".yaml", ".yml"],
            doc = "Optional oapi-codegen config file (`-config`). Must not " +
                  "set `output:`; the rule controls the output path.",
        ),
        "data": attr.label_list(
            allow_files = True,
            doc = "Other files the spec references through `$ref`. They " +
                  "must sit at the same relative paths as in the source tree.",
        ),
        "out": attr.string(
            doc = "Output file name. Defaults to `<name>.gen.go`.",
        ),
        "_oapi_codegen": attr.label(
            default = Label("//:oapi-codegen"),
            executable = True,
            cfg = "exec",
        ),
    },
    toolchains = [_GO_TOOLCHAIN],
)
