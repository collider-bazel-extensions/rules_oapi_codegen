"""rules_oapi_codegen — hermetic oapi-codegen (OpenAPI → Go) for Bazel: oapi_codegen, go_oapi_client."""

module(
    name = "rules_oapi_codegen",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.50.0")

# Go SDK used to build oapi-codegen and to run `go env` for its goimports
# pass. oapi-codegen v2.8 needs Go >= 1.25. A root module's own
# go_sdk.download takes precedence; see README "Go SDK".
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.10")

# oapi-codegen is built from source at the version pinned in go.mod, and
# generated clients link against oapi-codegen/runtime from the same file.
# Bump both with tools/update_versions.sh. kin-openapi is used only by
# tests/server (generated `spec` code imports it).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_getkin_kin_openapi",
    "com_github_oapi_codegen_oapi_codegen_v2",
    "com_github_oapi_codegen_runtime",
)

# ---- dev-only: rules_shell for the in-tree output assertions ----------------
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
