"""rules_oapi_codegen — hermetic OpenAPI codegen for Bazel: oapi_codegen, go_oapi_client (Go), ts_oapi_types (TypeScript)."""

module(
    name = "rules_oapi_codegen",
    version = "0.2.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.50.0")
bazel_dep(name = "platforms", version = "0.0.11")

# Go SDK used to build oapi-codegen and to run `go env` for its goimports
# pass. oapi-codegen v2.8 needs Go >= 1.25. A root module's own
# go_sdk.download takes precedence; see README "Go SDK".
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.10")

# oapi-codegen is built from source at the version pinned in go.mod, and
# generated clients link against oapi-codegen/runtime from the same file.
# Bump both with tools/update_versions.sh. kin-openapi is used only by
# tests/server (generated `spec` code imports it).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_getkin_kin_openapi",
    "com_github_oapi_codegen_oapi_codegen_v2",
    "com_github_oapi_codegen_runtime",
)

# ts_oapi_types: a sha256-pinned Node.js per exec platform and the npm tree
# pinned by private/npm/package-lock.json (openapi-typescript, typescript).
# Repositories are lazy: builds that never use ts_oapi_types (Go-only
# consumers) fetch none of them.
ts_deps = use_extension("//private:ts_deps.bzl", "ts_deps")
use_repo(
    ts_deps,
    "oapi_ts_node_darwin_amd64",
    "oapi_ts_node_darwin_arm64",
    "oapi_ts_node_linux_amd64",
    "oapi_ts_node_linux_arm64",
    "oapi_ts_npm",
)

# ---- dev-only: rules_shell for the in-tree output assertions ----------------
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
